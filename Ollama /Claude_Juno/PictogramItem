package org.example;

import java.util.List;

/**
 * Representa um item de vocabulário/pictograma de uma prancha de CAA.
 * Ex.: tipo="Verbo", palavra="comer", sinonimo="alimentar-se".
 */
public class PictogramItem {

    private final String tipo;
    private final String palavra;
    private final String sinonimo;
    private List<Double> embedding; // vetor gerado pelo modelo de embeddings

    public PictogramItem(String tipo, String palavra, String sinonimo) {
        this.tipo = tipo;
        this.palavra = palavra;
        this.sinonimo = sinonimo;
    }

    public String getTipo() {
        return tipo;
    }

    public String getPalavra() {
        return palavra;
    }

    public String getSinonimo() {
        return sinonimo;
    }

    public List<Double> getEmbedding() {
        return embedding;
    }

    public void setEmbedding(List<Double> embedding) {
        this.embedding = embedding;
    }

    /**
     * Texto usado para calcular o embedding. Combinar palavra + sinônimo + tipo
     * dá mais contexto semântico ao vetor do que usar só a palavra isolada.
     */
    public String textoParaEmbedding() {
        return String.format("%s: %s (sinônimo: %s)", tipo, palavra, sinonimo);
    }

    @Override
    public String toString() {
        return tipo + " | " + palavra + " | " + sinonimo;
    }
}
