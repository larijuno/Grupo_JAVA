package org.example;

import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;

import java.net.URI;
import java.net.URLEncoder;
import java.net.http.HttpClient;
import java.net.http.HttpRequest;
import java.net.http.HttpResponse;
import java.nio.charset.StandardCharsets;
import java.util.ArrayList;
import java.util.List;

public class Arasaac {

    private final HttpClient client = HttpClient.newHttpClient();
    private final ObjectMapper mapper = new ObjectMapper();

    public List<ItemArasaac> buscar(String palavra) throws Exception {

        String palavraCodificada =
                URLEncoder.encode(palavra, StandardCharsets.UTF_8);

        String url =
                "https://api.arasaac.org/v1/pictograms/pt/bestsearch/"
                        + palavraCodificada;

        HttpRequest request =
                HttpRequest.newBuilder()
                        .uri(URI.create(url))
                        .GET()
                        .build();

        HttpResponse<String> response =
                client.send(
                        request,
                        HttpResponse.BodyHandlers.ofString()
                );

        JsonNode raiz =
                mapper.readTree(response.body());

        List<ItemArasaac> resultados =
                new ArrayList<>();

        for (JsonNode pictograma : raiz) {

            int id =
                    pictograma.get("_id").asInt();

            String palavraPrincipal = palavra;

            if (pictograma.has("keywords")
                    && pictograma.get("keywords").size() > 0) {

                JsonNode keyword =
                        pictograma.get("keywords").get(0);

                if (keyword.has("keyword")) {
                    palavraPrincipal =
                            keyword.get("keyword").asText();
                }
            }

            resultados.add(
                    new ItemArasaac(
                            id,
                            palavraPrincipal
                    )
            );
        }

        return resultados;
    }
}
